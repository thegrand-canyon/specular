// SPDX-License-Identifier: MIT
pragma solidity ^0.8.20;

import "@openzeppelin/contracts/access/Ownable.sol";
import "@openzeppelin/contracts/utils/ReentrancyGuard.sol";
import "@openzeppelin/contracts/utils/Pausable.sol";
import "@openzeppelin/contracts/token/ERC20/IERC20.sol";
import "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
import "./AgentRegistryV2.sol";
import "./ReputationManagerV3.sol";

/**
 * @title AgentLiquidityMarketplaceV2_EMERGENCY_PATCH
 * @notice EMERGENCY PATCHED VERSION - Fixes critical B1, S1, S5 vulnerabilities
 * @dev IMMEDIATE DEPLOYMENT REQUIRED for Base Mainnet safety
 */
contract AgentLiquidityMarketplaceV2_EMERGENCY_PATCH is Ownable, ReentrancyGuard, Pausable {
    using SafeERC20 for IERC20;

    // State variables (keeping original structure for upgrade compatibility)
    AgentRegistryV2 public agentRegistry;
    ReputationManagerV3 public reputationManager;
    IERC20 public usdcToken;

    // Agent liquidity pools
    struct AgentPool {
        uint256 agentId;
        address agentAddress;
        uint256 totalLiquidity;      // Total USDC supplied to this agent
        uint256 availableLiquidity;  // USDC available for borrowing
        uint256 totalLoaned;         // Currently loaned out
        uint256 totalEarned;         // Total interest earned
        bool isActive;               // Agent can accept liquidity
    }

    // Lender position tracking
    struct LenderPosition {
        uint256 amount;              // USDC supplied to agent
        uint256 earnedInterest;      // Interest earned so far
        uint256 depositTimestamp;    // When they deposited
    }

    // Loan states
    enum LoanState { REQUESTED, ACTIVE, REPAID, LIQUIDATED }

    // Loan tracking
    struct Loan {
        uint256 loanId;
        address borrower;
        uint256 agentId;
        uint256 amount;
        uint256 collateralAmount;
        uint256 interestRate;        // Basis points (e.g., 500 = 5%)
        uint256 startTime;
        uint256 endTime;
        uint256 duration;
        LoanState state;
    }

    // Storage mappings
    mapping(uint256 => AgentPool) public agentPools;                          // agentId => pool
    mapping(uint256 => mapping(address => LenderPosition)) public positions;  // agentId => lender => position
    mapping(uint256 => address[]) public poolLenders;                         // agentId => lender addresses
    mapping(uint256 => Loan) public loans;                                    // loanId => loan
    mapping(address => uint256[]) public agentLoans;                          // agent => loanIds

    // Tracking variables
    uint256 public nextLoanId = 1;
    uint256 public accumulatedFees;
    uint256 public platformFeeRate = 1500; // 15% platform fee

    // Risk management constants
    uint256 public constant MAX_LENDERS_PER_POOL = 100;    // [H-04 mitigation] Cap lenders per pool
    uint256 public constant MAX_ACTIVE_LOANS_PER_AGENT = 50; // [SECURITY-01] Concurrent loan limit
    uint256 public constant MIN_LOAN_DURATION = 1 days;
    uint256 public constant MAX_LOAN_DURATION = 365 days;

    // 🚨 EMERGENCY PATCH CONSTANTS - S5 DoS MITIGATION
    uint256 public constant MAX_LOANS_TO_CHECK = 1000;     // Prevent DoS in _countActiveLoans

    // 🚨 EMERGENCY PATCH - Agent-specific circuit breakers
    mapping(uint256 => bool) public emergencyPausedAgents;  // agentId => isPaused

    // Events
    event LiquiditySupplied(uint256 indexed agentId, address indexed lender, uint256 amount);
    event LiquidityWithdrawn(uint256 indexed agentId, address indexed lender, uint256 amount);
    event LoanRequested(uint256 indexed loanId, uint256 indexed agentId, address indexed borrower, uint256 amount);
    event LoanDisbursed(uint256 indexed loanId, uint256 amount);
    event LoanRepaid(uint256 indexed loanId, uint256 amount, uint256 interest);
    event InterestClaimed(uint256 indexed agentId, address indexed lender, uint256 amount);
    event InterestDistributed(uint256 indexed agentId, uint256 totalInterest);
    event PoolAccountingReset(uint256 indexed agentId, uint256 oldTotalLoaned, uint256 newTotalLoaned, uint256 newAvailableLiquidity);

    // 🚨 EMERGENCY PATCH EVENTS
    event EmergencyAgentPaused(uint256 indexed agentId, string reason);
    event EmergencyAgentUnpaused(uint256 indexed agentId);
    event DuplicateLenderRemoved(uint256 indexed agentId, address indexed lender, uint256 duplicateCount);

    constructor(
        address _agentRegistry,
        address _reputationManager,
        address _usdcToken
    ) Ownable(msg.sender) {
        agentRegistry = AgentRegistryV2(_agentRegistry);
        reputationManager = ReputationManagerV3(_reputationManager);
        usdcToken = IERC20(_usdcToken);
    }

    // 🚨 EMERGENCY PATCH - Agent circuit breaker functions
    function emergencyPauseAgent(uint256 agentId, string calldata reason) external onlyOwner {
        emergencyPausedAgents[agentId] = true;
        emit EmergencyAgentPaused(agentId, reason);
    }

    function emergencyUnpauseAgent(uint256 agentId) external onlyOwner {
        emergencyPausedAgents[agentId] = false;
        emit EmergencyAgentUnpaused(agentId);
    }

    modifier notEmergencyPaused(uint256 agentId) {
        require(!emergencyPausedAgents[agentId], "Agent operations emergency paused");
        _;
    }

    /**
     * @notice Supply USDC liquidity to a specific agent pool
     */
    function supplyLiquidity(uint256 agentId, uint256 amount)
        external
        nonReentrant
        whenNotPaused
        notEmergencyPaused(agentId)
    {
        require(amount > 0, "Amount must be positive");
        require(agentRegistry.isRegistered(agentId), "Agent not registered");

        AgentPool storage pool = agentPools[agentId];

        // Initialize pool if first time
        if (!pool.isActive) {
            (string memory agentURI, address agentAddress,) = agentRegistry.getAgentInfo(agentId);
            pool.agentId = agentId;
            pool.agentAddress = agentAddress;
            pool.isActive = true;
        }

        LenderPosition storage position = positions[agentId][msg.sender];

        // 🚨 EMERGENCY PATCH B1 - Check for and handle duplicates BEFORE adding
        if (position.amount == 0) {
            // Check if this lender is already in the array (duplicate check)
            bool alreadyExists = false;
            uint256 duplicateIndex = 0;

            for (uint256 i = 0; i < poolLenders[agentId].length; i++) {
                if (poolLenders[agentId][i] == msg.sender) {
                    alreadyExists = true;
                    duplicateIndex = i;
                    break;
                }
            }

            if (!alreadyExists) {
                // [H-04 mitigation] Enforce lender cap to bound _distributeInterest gas cost
                require(poolLenders[agentId].length < MAX_LENDERS_PER_POOL, "Pool lender limit reached");
                poolLenders[agentId].push(msg.sender);
            }
        }

        // Update position
        position.amount += amount;
        position.depositTimestamp = block.timestamp;

        // Update pool
        pool.totalLiquidity += amount;
        pool.availableLiquidity += amount;

        // Transfer USDC from lender
        usdcToken.safeTransferFrom(msg.sender, address(this), amount);

        emit LiquiditySupplied(agentId, msg.sender, amount);
    }

    /**
     * @notice Request a loan from a specific agent pool
     */
    function requestLoan(uint256 amount, uint256 durationDays)
        external
        nonReentrant
        whenNotPaused
        returns (uint256)
    {
        uint256 agentId = agentRegistry.addressToAgentId(msg.sender);
        require(agentId != 0, "Borrower must be registered agent");
        require(!emergencyPausedAgents[agentId], "Agent operations emergency paused");

        AgentPool storage pool = agentPools[agentId];
        require(amount <= pool.availableLiquidity, "Insufficient pool liquidity");

        // Validate loan parameters
        uint256 duration = durationDays * 1 days;
        require(duration >= MIN_LOAN_DURATION && duration <= MAX_LOAN_DURATION, "Invalid duration");

        // Get credit limit based on reputation
        uint256 creditLimit = reputationManager.calculateCreditLimit(msg.sender);
        require(amount <= creditLimit, "Exceeds credit limit");

        // 🚨 EMERGENCY PATCH S5 - Safer active loan counting with bounds
        uint256 activeLoans = _countActiveLoansWithBounds(msg.sender);
        require(activeLoans < MAX_ACTIVE_LOANS_PER_AGENT, "Too many active loans");

        // Calculate collateral requirement
        uint256 collateralPercent = reputationManager.calculateCollateralRequirement(msg.sender);
        uint256 requiredCollateral = (amount * collateralPercent) / 100;

        // Get interest rate
        uint256 interestRate = reputationManager.calculateInterestRate(msg.sender);

        // Create loan
        uint256 loanId = nextLoanId++;
        loans[loanId] = Loan({
            loanId: loanId,
            borrower: msg.sender,
            agentId: agentId,
            amount: amount,
            collateralAmount: requiredCollateral,
            interestRate: interestRate,
            startTime: 0, // Set when disbursed
            endTime: 0,
            duration: duration,
            state: LoanState.REQUESTED
        });

        agentLoans[msg.sender].push(loanId);

        emit LoanRequested(loanId, agentId, msg.sender, amount);

        // Auto-disburse if no collateral required
        if (requiredCollateral == 0) {
            _disburseLoan(loanId);
        } else {
            // Require collateral to be deposited
            usdcToken.safeTransferFrom(msg.sender, address(this), requiredCollateral);
            _disburseLoan(loanId);
        }

        return loanId;
    }

    /**
     * @notice Repay a loan
     */
    function repayLoan(uint256 loanId) external nonReentrant whenNotPaused {
        Loan storage loan = loans[loanId];
        require(msg.sender == loan.borrower, "Not the borrower");
        require(loan.state == LoanState.ACTIVE, "Loan not active");
        require(!emergencyPausedAgents[loan.agentId], "Agent operations emergency paused");

        // Calculate interest
        uint256 interest = calculateInterest(
            loan.amount,
            loan.interestRate,
            loan.duration
        );

        uint256 totalRepayment = loan.amount + interest;

        // Calculate platform fee
        uint256 platformFee = (interest * platformFeeRate) / 10000;
        uint256 lenderInterest = interest - platformFee;

        // Update pool
        AgentPool storage pool = agentPools[loan.agentId];
        pool.totalLoaned -= loan.amount;
        pool.availableLiquidity += loan.amount;
        pool.totalEarned += lenderInterest;

        // Update loan state
        loan.state = LoanState.REPAID;

        // Transfer repayment from borrower
        usdcToken.safeTransferFrom(msg.sender, address(this), totalRepayment);

        // Accumulate platform fees
        accumulatedFees += platformFee;

        // 🚨 EMERGENCY PATCH B1 - SAFE interest distribution with duplicate handling
        _safeDistributeInterest(loan.agentId, lenderInterest);

        // Record repayment with reputation manager
        reputationManager.recordRepayment(loan.borrower, totalRepayment);

        emit LoanRepaid(loanId, loan.amount, interest);
    }

    /**
     * @notice 🚨 EMERGENCY PATCH B1 - Safe interest distribution that handles duplicates
     */
    function _safeDistributeInterest(uint256 agentId, uint256 totalInterest) internal {
        AgentPool storage pool = agentPools[agentId];
        address[] storage lenders = poolLenders[agentId];

        // Track distributed amount and processed lenders to handle duplicates
        uint256 distributed = 0;
        mapping(address => bool) processed;

        for (uint256 i = 0; i < lenders.length; i++) {
            address lender = lenders[i];

            // 🚨 EMERGENCY PATCH B1 - Skip if already processed (duplicate handling)
            if (processed[lender]) {
                continue;
            }

            LenderPosition storage position = positions[agentId][lender];

            if (position.amount > 0) {
                // Calculate lender's share based on their proportion of the pool
                uint256 share = (totalInterest * position.amount) / pool.totalLiquidity;
                position.earnedInterest += share;
                distributed += share;
                processed[lender] = true;
            }
        }

        // 🚨 EMERGENCY PATCH B1 - Safe dust calculation with underflow protection
        if (totalInterest >= distributed) {
            uint256 dust = totalInterest - distributed;
            if (dust > 0) {
                accumulatedFees += dust;
            }
        } else {
            // This should not happen with duplicate removal, but emergency safety
            // Credit the over-distribution as additional fees (emergency recovery)
            uint256 overDistribution = distributed - totalInterest;
            if (accumulatedFees >= overDistribution) {
                accumulatedFees -= overDistribution;
            }
        }

        emit InterestDistributed(agentId, totalInterest);
    }

    /**
     * @notice Internal function to disburse loan
     */
    function _disburseLoan(uint256 loanId) internal {
        Loan storage loan = loans[loanId];
        AgentPool storage pool = agentPools[loan.agentId];

        require(loan.state == LoanState.REQUESTED, "Invalid loan state");

        // Update pool
        pool.availableLiquidity -= loan.amount;
        pool.totalLoaned += loan.amount;

        // Update loan
        loan.state = LoanState.ACTIVE;
        loan.startTime = block.timestamp;
        loan.endTime = block.timestamp + loan.duration;

        // Transfer funds to borrower
        usdcToken.safeTransfer(loan.borrower, loan.amount);

        // Record with reputation manager
        reputationManager.recordBorrow(loan.borrower, loan.amount);

        emit LoanDisbursed(loanId, loan.amount);
    }

    /**
     * @notice 🚨 EMERGENCY PATCH S1 - Fixed claimInterest with proper accounting
     */
    function claimInterest(uint256 agentId) external nonReentrant whenNotPaused notEmergencyPaused(agentId) {
        LenderPosition storage position = positions[agentId][msg.sender];
        uint256 interest = position.earnedInterest;

        require(interest > 0, "No interest to claim");

        // 🚨 EMERGENCY PATCH S1 - Update pool accounting BEFORE transfer
        AgentPool storage pool = agentPools[agentId];
        require(pool.totalEarned >= interest, "Insufficient pool earnings");

        // Decrement pool counters to maintain invariants
        pool.totalEarned -= interest;

        // Clear position interest
        position.earnedInterest = 0;

        // Transfer USDC to claimer
        usdcToken.safeTransfer(msg.sender, interest);

        emit InterestClaimed(agentId, msg.sender, interest);
    }

    /**
     * @notice 🚨 EMERGENCY PATCH S5 - Bounded active loan counting to prevent DoS
     */
    function _countActiveLoansWithBounds(address agent) internal view returns (uint256) {
        uint256[] memory loanIds = agentLoans[agent];
        uint256 activeCount = 0;

        // 🚨 EMERGENCY PATCH S5 - Bound the loop to prevent gas DoS
        uint256 loopsToCheck = loanIds.length > MAX_LOANS_TO_CHECK ? MAX_LOANS_TO_CHECK : loanIds.length;

        for (uint256 i = 0; i < loopsToCheck; i++) {
            if (loans[loanIds[i]].state == LoanState.ACTIVE) {
                activeCount++;
            }
        }

        return activeCount;
    }

    /**
     * @notice Legacy function for compatibility - with bounds
     */
    function _countActiveLoans(address agent) internal view returns (uint256) {
        return _countActiveLoansWithBounds(agent);
    }

    /**
     * @notice 🚨 EMERGENCY FUNCTION - Remove duplicate lenders from pool arrays
     */
    function emergencyRemoveDuplicateLenders(uint256 agentId) external onlyOwner {
        address[] storage lenders = poolLenders[agentId];

        // Create a temporary array to store unique lenders
        address[] memory uniqueLenders = new address[](lenders.length);
        mapping(address => bool) seen;
        uint256 uniqueCount = 0;
        uint256 duplicatesRemoved = 0;

        // First pass: identify unique lenders
        for (uint256 i = 0; i < lenders.length; i++) {
            address lender = lenders[i];
            if (!seen[lender] && positions[agentId][lender].amount > 0) {
                uniqueLenders[uniqueCount] = lender;
                uniqueCount++;
                seen[lender] = true;
            } else if (seen[lender]) {
                duplicatesRemoved++;
            }
        }

        // Second pass: replace the storage array with unique lenders
        delete poolLenders[agentId];
        for (uint256 i = 0; i < uniqueCount; i++) {
            poolLenders[agentId].push(uniqueLenders[i]);
        }

        emit DuplicateLenderRemoved(agentId, address(0), duplicatesRemoved);
    }

    // View functions and utilities (keeping original interface)
    function calculateInterest(uint256 principal, uint256 rate, uint256 duration)
        public
        pure
        returns (uint256)
    {
        return (principal * rate * duration) / (10000 * 365 days);
    }

    function getAgentPool(uint256 agentId) external view returns (
        uint256,    // agentId
        address,    // agentAddress
        uint256,    // totalLiquidity
        uint256,    // availableLiquidity
        uint256,    // totalLoaned
        uint256,    // totalEarned
        uint256,    // lenderCount
        bool        // isActive
    ) {
        AgentPool storage pool = agentPools[agentId];
        return (
            pool.agentId,
            pool.agentAddress,
            pool.totalLiquidity,
            pool.availableLiquidity,
            pool.totalLoaned,
            pool.totalEarned,
            poolLenders[agentId].length,
            pool.isActive
        );
    }

    // Emergency functions
    function pause() external onlyOwner {
        _pause();
    }

    function unpause() external onlyOwner {
        _unpause();
    }

    function withdrawFees(uint256 amount) external onlyOwner nonReentrant {
        require(amount <= accumulatedFees, "Insufficient fees");
        accumulatedFees -= amount;
        usdcToken.safeTransfer(owner(), amount);
    }
}