# ===========================================
# Private Key (NEVER commit the real .env file!)
# ===========================================
PRIVATE_KEY=your_private_key_here

# ===========================================
# Ethereum RPC URLs
# ===========================================
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# ===========================================
# Base RPC URLs
# ===========================================
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# ===========================================
# Arc Mainnet deploy (fill from Circle's official docs before deploying)
# Used by scripts/deploy-arc-mainnet.js and the arcMainnet hardhat network.
# ===========================================
ARC_MAINNET_RPC_URL=
ARC_MAINNET_CHAIN_ID=
ARC_MAINNET_USDC=
# ARC_MAINNET_MIN_GAS=0.01
# Optional protective levers to enable at deploy (audit 2026-07):
# SPECULAR_BIND_BORROW=1              # M-1: restrict borrowing to pool creator
# SPECULAR_MIN_HOLD_SECONDS=3600     # M-2: min loan hold before reputation reward
# FAUCET_MAX_ELIGIBLE_AGENT_ID=0     # faucet: 0 = grants disabled

# ===========================================
# Arbitrum RPC URLs
# ===========================================
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# ===========================================
# Optimism RPC URLs
# ===========================================
OPTIMISM_RPC_URL=https://mainnet.optimism.io
OPTIMISM_SEPOLIA_RPC_URL=https://sepolia.optimism.io

# ===========================================
# Polygon RPC URLs
# ===========================================
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# ===========================================
# Block Explorer API Keys (for contract verification)
# ===========================================
ETHERSCAN_API_KEY=your_etherscan_api_key
BASESCAN_API_KEY=your_basescan_api_key
ARBISCAN_API_KEY=your_arbiscan_api_key
OPTIMISM_ETHERSCAN_API_KEY=your_optimism_etherscan_api_key
POLYGONSCAN_API_KEY=your_polygonscan_api_key

# ===========================================
# SDK Configuration
# ===========================================
DEFAULT_NETWORK=sepolia
LOG_LEVEL=info

# ===========================================
# Security flags (added by the July 2026 SDK audit)
# See forensics/output/security-audit-2026-07/SDK_SECURITY_AUDIT_2026-07.md
# ===========================================
# walletPersist (TEST-ONLY): persist a generated wallet key across runs. Keys
# are stored as an ENCRYPTED keystore — persistence is disabled unless you opt
# in AND supply a password (>=8 chars). Never enable in production.
SPECULAR_ALLOW_KEY_PERSIST=0
SPECULAR_KEYSTORE_PASSWORD=

# x402 seller (SpecularX402Server):
#   stub mode does NO payment verification — opt in explicitly for tests/dev only.
SPECULAR_X402_ALLOW_STUB=0
#   Bearer token gating GET /__specular_x402/stats (unset ⇒ loopback-only).
SPECULAR_X402_STATS_TOKEN=
#   Base URL used to build the payment `resource` server-side (else derived
#   from request Host headers).
SPECULAR_X402_BASE_URL=

# NOTE: the x402 client's per-payment cap (default 10 USDC) is a constructor
# option (maxPayment), not an env var. Raise it in code to authorize larger
# payments; pass null to opt out of the cap entirely.

# ===========================================
# Optional: Gas Reporting
# ===========================================
REPORT_GAS=false
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key

# ===========================================
# NOTES:
# ===========================================
# 1. Get free RPC URLs from:
#    - Alchemy: https://www.alchemy.com/
#    - Infura: https://www.infura.io/
#    - QuickNode: https://www.quicknode.com/
#
# 2. Get block explorer API keys from:
#    - Etherscan: https://etherscan.io/apis
#    - Basescan: https://basescan.org/apis
#    - Arbiscan: https://arbiscan.io/apis
#    - Optimism Etherscan: https://optimistic.etherscan.io/apis
#    - Polygonscan: https://polygonscan.com/apis
#
# 3. SECURITY WARNING:
#    - Never commit your .env file to git
#    - Use a dedicated deployment wallet
#    - Keep private keys secure

# ===========================================
# Agent integration server (mcp-server/) — see mcp-server/.env.example for the full list.
# The remote server is NON-CUSTODIAL and refuses to start if SPECULAR_PRIVATE_KEY is set.
# ===========================================
# SPECULAR_ENABLED_NETWORKS=arc-staging      # base | arc-staging | arc-mainnet (base/arc-mainnet = real USDC)
# SPECULAR_MCP_TOKEN=                        # optional bearer token for /mcp and /v1
# SPECULAR_RATE_LIMIT_PER_MIN=120
# SPECULAR_MAX_AMOUNT_USDC=100000
# SPECULAR_LOCAL_SIGNER=0                    # stdio mode only: 1 + SPECULAR_PRIVATE_KEY exposes local_sign_and_broadcast
