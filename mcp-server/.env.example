# Specular agent server (mcp-server) — environment
# Copy to mcp-server/.env for local runs; on Railway set these as service variables.
# The REMOTE server (npm start / dist/http.js) is NON-CUSTODIAL and REFUSES TO START
# if SPECULAR_PRIVATE_KEY is present in its environment.

# ---- HTTP server ----
PORT=3400
HOST=0.0.0.0
# Networks this deployment serves (comma separated: base, arc-staging, arc-mainnet).
# arc-staging is testnet; base and arc-mainnet move REAL USDC. Default: all three.
SPECULAR_ENABLED_NETWORKS=arc-staging
# Optional bearer token. When set, /mcp and /v1/* require "Authorization: Bearer <token>";
# /health and /openapi.json stay open. When unset, everything is open but rate-limited per IP.
SPECULAR_MCP_TOKEN=
# Per-IP sliding-window limits (requests/minute).
SPECULAR_RATE_LIMIT_PER_MIN=120
SPECULAR_BROADCAST_LIMIT_PER_MIN=20
# CORS allow-list (comma separated origins, or * ).
SPECULAR_ALLOWED_ORIGINS=*
# JSON body limit.
SPECULAR_BODY_LIMIT=256kb
# Public URL used in /openapi.json "servers" (else derived from the request Host).
SPECULAR_PUBLIC_URL=
# Express trust-proxy hops. Railway's chain is "<client>, <edge>" (two hops), so the default on Railway
# (RAILWAY_ENVIRONMENT set) is 2. VERIFY after deploy: the access log's "ip" must equal your real IP
# (the "xff" field shows the raw chain). With the wrong count the per-IP limiter keys on the proxy and
# every client shares one bucket.
SPECULAR_TRUST_PROXY=
# Optional: name of a header the proxy OVERWRITES with the real client IP (e.g. x-real-ip on Railway).
# Takes precedence over the hop walk. Only set it if you verified the proxy overwrites it.
SPECULAR_CLIENT_IP_HEADER=
# Max concurrently executing /v1 and /mcp requests; beyond it the server answers 503 + Retry-After: 1.
SPECULAR_MAX_INFLIGHT=64
# /health result cache (ms). /health is unauthenticated and unlimited; the cache bounds its RPC fan-out.
SPECULAR_HEALTH_CACHE_MS=10000
# Upstream RPC per-attempt timeout (ms) and attempts on 429/5xx. Bounds how long a read can hang.
SPECULAR_RPC_TIMEOUT_MS=15000
SPECULAR_RPC_MAX_ATTEMPTS=3
# Per-call USDC amount cap for prepared txs and relayed approves (display units). Loans are additionally capped at 50,000.
SPECULAR_MAX_AMOUNT_USDC=100000
# debug | info | warn | error  (JSON lines to stdout; never contains keys, tokens or bodies)
LOG_LEVEL=info

# ---- RPC overrides (addresses are NEVER configurable; they come from ../src/config/*.json) ----
SPECULAR_RPC_BASE=https://mainnet.base.org
SPECULAR_RPC_ARC_STAGING=https://arc-testnet.drpc.org
SPECULAR_RPC_ARC_MAINNET=https://rpc.mainnet.arc.io
# Override the repo root used to find src/config (default: parent of mcp-server/).
SPECULAR_REPO_ROOT=

# ---- stdio / local mode ONLY (npm run start:stdio, Claude Desktop) ----
# The local signer tool `local_sign_and_broadcast` is exposed ONLY when BOTH are set.
# Never set these for the remote server.
SPECULAR_LOCAL_SIGNER=0
SPECULAR_PRIVATE_KEY=
