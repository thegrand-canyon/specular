# Specular agent server (mcp-server) — environment
# Copy to mcp-server/.env for local runs; on Railway set these as service variables.
# The REMOTE server (npm start / dist/http.js) is NON-CUSTODIAL and REFUSES TO START
# if SPECULAR_PRIVATE_KEY is present in its environment.

# ---- HTTP server ----
PORT=3400
HOST=0.0.0.0
# Networks this deployment serves (comma separated: base, arc-staging, arc-mainnet).
# arc-staging is testnet; base and arc-mainnet move REAL USDC. Default: all three.
SPECULAR_ENABLED_NETWORKS=arc-staging
# Optional bearer token. When set, /mcp and /v1/* require "Authorization: Bearer <token>";
# /health and /openapi.json stay open. When unset, everything is open but rate-limited per IP.
SPECULAR_MCP_TOKEN=
# Per-IP sliding-window limits (requests/minute).
SPECULAR_RATE_LIMIT_PER_MIN=120
SPECULAR_BROADCAST_LIMIT_PER_MIN=20
# CORS allow-list (comma separated origins, or * ).
SPECULAR_ALLOWED_ORIGINS=*
# JSON body limit.
SPECULAR_BODY_LIMIT=256kb
# Public URL used in /openapi.json "servers" (else derived from the request Host).
SPECULAR_PUBLIC_URL=
# Express trust-proxy hops. Railway's chain is "<client>, <edge>" (two hops), so the default on Railway
# (RAILWAY_ENVIRONMENT set) is 2. VERIFY after deploy: the access log's "ip" must equal your real IP
# (the "xff" field shows the raw chain). With the wrong count the per-IP limiter keys on the proxy and
# every client shares one bucket.
SPECULAR_TRUST_PROXY=
# Optional: name of a header the proxy OVERWRITES with the real client IP (e.g. x-real-ip on Railway).
# Takes precedence over the hop walk. Only set it if you verified the proxy overwrites it.
SPECULAR_CLIENT_IP_HEADER=
# Max concurrently executing /v1 and /mcp requests; beyond it the server answers 503 + Retry-After: 1.
SPECULAR_MAX_INFLIGHT=64
# /health result cache (ms). /health is unauthenticated and unlimited; the cache bounds its RPC fan-out.
SPECULAR_HEALTH_CACHE_MS=10000
# ---- Upstream RPC resilience (2026-09-22) ----
# Per-attempt upstream timeout (ms) and the total number of attempts for ONE JSON-RPC call,
# walking the endpoint ring below. 8s x 3 fits inside the request deadline with failover.
SPECULAR_RPC_TIMEOUT_MS=8000
SPECULAR_RPC_MAX_ATTEMPTS=3
# Overall budget for one /v1 or /mcp request (ms). Every upstream attempt is clamped to what is
# left of it; overruns answer 504 + Retry-After instead of hanging. 0 disables the deadline.
SPECULAR_REQUEST_DEADLINE_MS=20000
# Endpoint health: consecutive non-429 failures before an endpoint is taken out of rotation
# (a 429 takes it out on the first one), and the exponential cold window it backs off for.
# When EVERY endpoint for a network is cold the circuit is open: reads fail fast with 503.
SPECULAR_RPC_FAILURE_THRESHOLD=2
SPECULAR_RPC_BACKOFF_MS=1000
SPECULAR_RPC_BACKOFF_MAX_MS=30000
# JSON-RPC response cache (network+method+params) and request coalescing. Set either to 0 to
# disable. Writes, nonce reads and `pending` tags are never cached or coalesced.
SPECULAR_RPC_CACHE=1
SPECULAR_RPC_COALESCE=1
SPECULAR_RPC_CACHE_HEAD_MS=2000        # chain head, gas, estimateGas
SPECULAR_RPC_CACHE_CALL_MS=4000        # eth_call against `latest`
SPECULAR_RPC_CACHE_STATIC_MS=3600000   # block-pinned data, eth_chainId, eth_getCode
SPECULAR_RPC_CACHE_IMMUTABLE_MS=300000 # a mined transaction / receipt
# Read-route cache (tool + arguments). The immutable TTL applies to answers that can never
# change: a REPAID/DEFAULTED loan, a mined get_transaction.
SPECULAR_READ_CACHE=1
SPECULAR_READ_CACHE_MS=3000
SPECULAR_READ_CACHE_IMMUTABLE_MS=300000
# Per-call USDC amount cap for prepared txs and relayed approves (display units). Loans are additionally capped at 50,000.
SPECULAR_MAX_AMOUNT_USDC=100000
# debug | info | warn | error  (JSON lines to stdout; never contains keys, tokens or bodies)
LOG_LEVEL=info

# ---- RPC overrides (addresses are NEVER configurable; they come from ../src/config/*.json) ----
# COMMA-SEPARATED LIST, in preference order. A single URL still works (it is a one-element list).
# The server fails over on 429 / 5xx / timeout / connection error and recovers automatically.
# Leave a variable unset to use the verified default list for that network:
#   arc-mainnet  rpc.mainnet.arc.io, arc-rpc.publicnode.com, arc.drpc.org
#   arc-staging  rpc.testnet.arc.io, arc-testnet-rpc.publicnode.com, arc-testnet.drpc.org
#   base         mainnet.base.org, base-rpc.publicnode.com
# dRPC is last on every list: it 429s this project's egress after moderate use.
# A paid/keyed endpoint is safe to put here — credentials are never echoed to clients
# (/v1/networks and /rpc-health reduce an operator endpoint to scheme://host/).
SPECULAR_RPC_BASE=https://mainnet.base.org,https://base-rpc.publicnode.com
SPECULAR_RPC_ARC_STAGING=https://rpc.testnet.arc.io,https://arc-testnet-rpc.publicnode.com
SPECULAR_RPC_ARC_MAINNET=https://rpc.mainnet.arc.io,https://arc-rpc.publicnode.com
# Override the repo root used to find src/config (default: parent of mcp-server/).
SPECULAR_REPO_ROOT=

# ---- stdio / local mode ONLY (npm run start:stdio, Claude Desktop) ----
# The local signer tool `local_sign_and_broadcast` is exposed ONLY when BOTH are set.
# Never set these for the remote server.
SPECULAR_LOCAL_SIGNER=0
SPECULAR_PRIVATE_KEY=
