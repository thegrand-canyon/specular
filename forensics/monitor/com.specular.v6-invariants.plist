<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  NOT INSTALLED BY DEFAULT (disabled 2026-09-22, re-confirmed 2026-09-24).

  This targets the superseded Arc TESTNET v4 stack, which carries a documented, accepted
  S1 leak (~74.87 USDC of phantom availableLiquidity). The monitor correctly reports it
  CRITICAL on every run, forever, against a stack that protects nothing. A monitor that
  cries wolf every 30 minutes is one people stop reading, so it is deliberately left
  uninstalled. It also predates run-with-alert.sh, so it cannot page anyway.

  Install only if you are actively working that stack.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.specular.v6-invariants</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>cd /Users/peterschroeder/Specular &amp;&amp; export PATH="/opt/homebrew/opt/node@22/bin:$PATH" &amp;&amp; node forensics/monitor/v6-invariants.js --quiet</string>
    </array>

    <key>StartInterval</key>
    <integer>1800</integer>

    <key>StandardOutPath</key>
    <string>/Users/peterschroeder/Specular/forensics/monitor/v6-invariants-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/peterschroeder/Specular/forensics/monitor/v6-invariants-stderr.log</string>

    <key>RunAtLoad</key>
    <false/>

    <key>WorkingDirectory</key>
    <string>/Users/peterschroeder/Specular</string>
</dict>
</plist>
