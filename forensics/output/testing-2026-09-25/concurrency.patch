+// Hardhat config for the 2026-09-25 CONCURRENCY harness.
+//
+// Differences from the project config (hardhat.config.js), all of them about being
+// able to build a block by hand rather than about how the contracts compile:
+//
+//   * `mining.mempool.order = "fifo"` — the default is "priority", which reorders the
+//     pending pool by effective gas price. FIFO makes "submission order == block order"
+//     the baseline so a race is only reordered when the harness explicitly bids a
+//     higher priority fee for it (the C1/C2 "who wins" cases do exactly that, and
+//     switch the order back on via `setMempoolOrder("priority")`).
+//   * 140 funded accounts — the 50-slot pool boundary needs 50 lenders + creator +
+//     spares, and hardhat ships 20.
+//   * a 120M block gas limit so a 50-way same-block batch is not silently split
+//     across two blocks (which would make it not a same-block test at all).
+//
+// Compiler settings are inherited verbatim so the bytecode under test is the shipped one.
+const base = require("./hardhat.config.js");
+
+module.exports = {
+    ...base,
+    networks: {
+        ...base.networks,
+        hardhat: {
+            ...base.networks.hardhat,
+            chainId: 31337,
+            blockGasLimit: 120_000_000,
+            allowUnlimitedContractSize: false,
+            accounts: {
+                mnemonic: "test test test test test test test test test test test junk",
+                count: 140,
+                accountsBalance: "10000000000000000000000",
+            },
+            mining: { auto: true, interval: 0, mempool: { order: "fifo" } },
+        },
+    },
+    // The harness lives beside the report, NOT under ./test — `npm test` uses the
+    // project config whose `paths.tests` is ./test and would otherwise pick these
+    // files up and fail them for want of 140 funded accounts.
+    paths: { ...base.paths, tests: "./forensics/output/testing-2026-09-25/harness" },
+    mocha: { timeout: 1_200_000 },
+};
