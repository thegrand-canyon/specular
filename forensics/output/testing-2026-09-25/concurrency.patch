+            const n = await p.getNetwork();
+            if (Number(n.chainId) !== CHAIN_ID) throw new Error(`chainId ${n.chainId}`);
+            await p.getBlockNumber();
+            log(`RPC: ${url}`);
+            return { provider: p, url };
+        } catch (e) { log(`  RPC ${url} unusable: ${short(e)}`); }
