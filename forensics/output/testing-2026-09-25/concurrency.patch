+    }
+
+    // ════════════ PHASE 4 — double-fire of the same settling call ══════════════
+    {
+        const phase = { phase: "7.4 concurrent double-fire of the same settlement", runs: [] };
+        for (let run = 0; run < 2; run++) {
+            // make sure there is liquidity, then open one loan
