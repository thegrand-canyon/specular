+    if (TRANSIENT_RPC_CODES.has(rpcCode)) return true;
+    if (rpcCode === 3) return false; // "execution reverted" — a definite answer
+  }
+  const msg = `${any.message ?? ''} ${any.shortMessage ?? ''} ${any?.info?.error?.message ?? ''}`;
